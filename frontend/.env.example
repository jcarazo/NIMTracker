# Real values only ever live in GitHub Actions repo secrets (Settings ->
# Secrets and variables -> Actions) -- never committed here. The
# deploy-frontend.yml workflow (Phase 7) maps the GH secrets SUPABASE_URL
# and SUPABASE_ANON_KEY into these VITE_-prefixed names at build time --
# Vite only exposes env vars to client code when they carry this prefix.
# For local dev, copy this file to .env and fill in the same values from
# Settings -> API Keys / Settings -> General on the Supabase dashboard.

# Project URL, e.g. https://huladiqsospiarkumujz.supabase.co
VITE_SUPABASE_URL=

# Publishable key (safe to expose client-side -- see db/rls_policies.sql;
# RLS is the actual security boundary, not key secrecy).
VITE_SUPABASE_ANON_KEY=
