# Real values only ever live in GitHub Actions repo secrets (Settings ->
# Secrets and variables -> Actions) -- never committed here. These are
# the exact secret names the catalog-discovery.yml / completions-sweep.yml
# workflows reference.

# NVIDIA NIM API key used by the hourly completions probe.
NIM_API_KEY=

# Supabase Session pooler connection string (NOT the direct connection --
# see NIMTracker-implementation-plan.md section 6, step 3). Used by db.py
# for direct Postgres writes from the catalog + completions jobs.
SUPABASE_DB_URL=
